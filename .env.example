# Copy this file to .env and fill in your Microsoft Foundry project values.
# Never commit your .env file to GitHub.
# All agents inside the same Foundry project share one AZURE_FOUNDRY_PROJECT_ENDPOINT.

AZURE_FOUNDRY_PROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<your-project>"

# Agent names configured in your Microsoft Foundry project
AZURE_FOUNDRY_POC_AGENT_NAME="POC1"
AZURE_FOUNDRY_VOICE_AGENT_NAME="customer-support-agent"
AZURE_FOUNDRY_EXPENSES_AGENT_NAME="expenses-agent"
AZURE_FOUNDRY_TEXT_TO_IMAGE_AGENT_NAME="text-to-image-poc"
